#!/usr/bin/env bash
# Prints the tools THIS container carries, as a ` | `-separated list, for the "ready" line of an entrypoint.
#
# Derived rather than hand-written, and that is the whole point: a hard-coded list goes stale the moment a script
# moves from one image's COPY list to another's, and it does so silently -- it misleads whoever reads
# `docker logs` about what the container can actually run. Measured 2026-08-26: the logic entrypoint's hand-kept
# list still advertised `foxglove`, which had moved to mock-robot, and nothing failed.
#
# What counts as a tool: every plain file directly in /usr/local/bin that starts with a shebang. A library
# without one (mock_hardware.py) is not something a human runs. Subtracted from that are the cross-cutting
# pieces that other tools source or that the entrypoint invokes, never the user:
#
#   ros-env, guard      sourced by the tools
#   clearlog         sourced by everything, and not even executable
#   zenoh-connect       called by the entrypoint
#   start-desktop       called by the entrypoint
#   ready-banner        this file
#
# Usage:  log_info "ready. Tools: %s" "$(ready-banner)"
set -euo pipefail

_tools=()
while IFS= read -r -d '' _f; do
    _name="$(basename "$_f")"
    case "$_name" in
        ros-env | guard | clearlog | zenoh-connect | start-desktop | ready-banner) continue ;;
    esac
    case "$(head -n1 "$_f" 2>/dev/null)" in
        '#!'*) _tools+=("$_name") ;;
    esac
done < <(find /usr/local/bin -maxdepth 1 -type f -print0 | sort -z)

# `"${arr[@]}"` of an EMPTY array aborts under `set -u` on bash 3.2 -- guard the expansion, do not assume one.
[ "${#_tools[@]}" -eq 0 ] && exit 0
_banner="$(printf '%s | ' "${_tools[@]}")"
printf '%s\n' "${_banner% | }"
