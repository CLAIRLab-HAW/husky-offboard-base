# clearlog -- the shell half of the console output from libs/clearlog.
#
# Do not execute it, source it:
#
#     . /usr/local/bin/clearlog
#     clearlog_name offboard.entry
#     log_info "robot.yaml loaded -> %s" "$dest"
#
# Produces the same line as ClearlogHandler: symbols and colour on a terminal, the level as a word and a full
# date without one -- so that `docker logs | grep WARN` carries. The two halves are tied together by a golden
# test: libs/clearlog/tests/test_shell_parity.py.
#
# Template plus arguments, not "...$var..." -- the same rule as in Python.
#
# CLEARLOG_LEVEL is read for its ROOT part only (the entry without '='). 'warning,twinlink.mcap=debug' acts here
# like 'warning'; the per-logger assignments stay a Python matter.
#
# EVERY function returns 0. Some of the scripts here run under `set -e`, and a non-zero return value would kill
# them in the middle of their setup. They also run under `set -u`: no reading of unset variables.
#
# Runs under POSIX sh (dash) exactly as under bash -- netbird-entrypoint-override.sh (#!/bin/sh) sources it in
# production, under set -eu as well. The one real requirement is GNU date for the milliseconds; without %3N the
# fractional digit is dropped, without the column shifting.

CLEARLOG_NAME="${CLEARLOG_NAME:-shell}"

clearlog_name() { CLEARLOG_NAME="${1:-shell}"; return 0; }

_cl_num() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        debug)          printf 10 ;;
        info)           printf 20 ;;
        warn|warning)   printf 30 ;;
        error)          printf 40 ;;
        critical|fatal) printf 50 ;;
        *)              printf 20 ;;
    esac
    return 0
}

# --- one-off initialisation on sourcing ------------------------------------

_cl_threshold=20
_cl_init_threshold() {
    local spec item old_ifs
    spec="${CLEARLOG_LEVEL:-}"
    [ -n "$spec" ] || return 0
    old_ifs="${IFS:-}"
    IFS=','
    for item in $spec; do
        case "$item" in
            *=*) : ;;                 # Zuweisung pro Logger -> nur Python
            "")  : ;;
            *)   _cl_threshold="$(_cl_num "$item")" ;;
        esac
    done
    IFS="$old_ifs"
    return 0
}

_cl_tty=0
_cl_init_tty() {
    case "$(printf '%s' "${CLEARLOG_COLOR:-auto}" | tr '[:upper:]' '[:lower:]')" in
        always) _cl_tty=1; return 0 ;;
        never)  _cl_tty=0; return 0 ;;
    esac
    if [ -n "${NO_COLOR+x}" ]; then _cl_tty=0; return 0; fi
    if [ -t 2 ]; then _cl_tty=1; else _cl_tty=0; fi
    return 0
}

# GNU date can do %3N; BSD date prints '%3N' literally.  Check once instead
# den Platzhalter in die Logs zu schreiben.
_cl_ms=1
_cl_init_ms() {
    case "$(date '+%3N' 2>/dev/null)" in
        ''|*[!0-9]*) _cl_ms=0 ;;
        *)           _cl_ms=1 ;;
    esac
    return 0
}

_cl_init_threshold
_cl_init_tty
_cl_init_ms

# --- Ausgabe ---------------------------------------------------------------

_cl_stamp() {
    if [ "$_cl_tty" = 1 ]; then
        if [ "$_cl_ms" = 1 ]; then date '+%H:%M:%S.%3N'
        else printf '%s    ' "$(date '+%H:%M:%S')"; fi   # Spalte bleibt 12
    else
        if [ "$_cl_ms" = 1 ]; then date '+%Y-%m-%d %H:%M:%S.%3N'
        else printf '%s    ' "$(date '+%Y-%m-%d %H:%M:%S')"; fi
    fi
    return 0
}

_cl_emit() {
    local num="$1" word="$2" sym="$3" col="$4"
    shift 4
    [ "$num" -ge "$_cl_threshold" ] || return 0
    local fmt="${1:-}"
    shift || true
    local msg stamp
    if [ "$#" -gt 0 ]; then
        # shellcheck disable=SC2059 -- template + arguments is precisely the intent.
        msg="$(printf "$fmt" "$@" 2>/dev/null)" || msg="$fmt"
    else
        # Like logging.LogRecord.getMessage(): without arguments the message stays untouched -- otherwise a
        # literal '%' destroys it silently (printf reads "% l" out of "20% loaded" as a conversion).
        msg="$fmt"
    fi
    stamp="$(_cl_stamp)"
    if [ "$_cl_tty" = 1 ]; then
        # A hard cut (%-20.20s) rather than Python's middle ellipsis from handler.py:shorten() -- a difference
        # accepted on purpose, not an oversight. The naming convention (<package>.<area>, at most 20 characters)
        # caps names at exactly NAME_WIDTH, so this case practically never arises.
        printf '\033[90m%s\033[0m %b%s\033[0m \033[90m%-20.20s\033[0m  %s\n' \
               "$stamp" "$col" "$sym" "$CLEARLOG_NAME" "$msg" >&2
    else
        printf '%s  %-5s  %s  %s\n' "$stamp" "$word" "$CLEARLOG_NAME" "$msg" >&2
    fi
    return 0
}

log_debug() { _cl_emit 10 DEBUG '·' '\033[90m'  "$@"; return 0; }
log_info()  { _cl_emit 20 INFO  '•' '\033[34m'  "$@"; return 0; }
log_warn()  { _cl_emit 30 WARN  '▲' '\033[33m'  "$@"; return 0; }
log_error() { _cl_emit 40 ERROR '✖' '\033[31m'  "$@"; return 0; }

log_phase() {
    [ 20 -ge "$_cl_threshold" ] || return 0
    local fmt="${1:-}"
    shift || true
    local title
    if [ "$#" -gt 0 ]; then
        # shellcheck disable=SC2059
        title="$(printf "$fmt" "$@" 2>/dev/null)" || title="$fmt"
    else
        # As in _cl_emit: without arguments do not format, or a literal '%' ("setup 50% done") destroys the
        # title silently.
        title="$fmt"
    fi
    if [ "$_cl_tty" = 1 ]; then
        local width="${COLUMNS:-80}" line=""
        local n=$(( width - ${#title} - 1 ))
        [ "$n" -lt 3 ] && n=3
        while [ "${#line}" -lt "$n" ]; do line="$line─"; done
        printf '\033[90m%s %s\033[0m\n' "$title" "$line" >&2
    else
        printf -- '--- %s ---\n' "$title" >&2
    fi
    return 0
}
